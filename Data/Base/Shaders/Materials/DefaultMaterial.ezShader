[PLATFORMS]
ALL

[PERMUTATIONS]

BLEND_MODE
RENDER_PASS
SHADING_MODE
TWO_SIDED
FLIP_WINDING
FORWARD_PASS_WRITE_DEPTH
MSAA
CAMERA_MODE
SHADING_QUALITY
VERTEX_SKINNING
SHADER_WRITE_DEPTH
POM_MODE

[MATERIALPARAMETER]

Permutation BLEND_MODE;
Permutation SHADING_MODE;
Permutation TWO_SIDED;
Permutation SHADER_WRITE_DEPTH;

Color BaseColor @Default(Color(1.0, 1.0, 1.0));
bool UseBaseTexture;
Texture2D BaseTexture;

float MaskThreshold @Default(0.25);
Texture2D DitherNoiseTexture @Default("{ ac614d7c-2b31-4a7b-aa0c-c5d8200b7b89 }");

bool UseNormalTexture;
Texture2D NormalTexture;

bool UseOcclusionTexture;
Texture2D OcclusionTexture;

float RoughnessValue @Default(0.7) @Clamp(0.0, 1.0);
bool UseRoughnessTexture;
Texture2D RoughnessTexture;

float MetallicValue @Default(0.0) @Clamp(0.0, 1.0);
bool UseMetallicTexture;
Texture2D MetallicTexture;

bool UseOrmTexture;
Texture2D OrmTexture;

Color EmissiveColor @Default(Color(0.0, 0.0, 0.0));
bool UseEmissiveTexture;
Texture2D EmissiveTexture;

bool UseHeightTexture;
Permutation POM_MODE;
bool PomWriteDepth;
Texture2D HeightTexture;
float HeightScale @Default(0.05) @Clamp(-0.3, 0.3);
int PomMaxSteps @Default(16) @Clamp(4, 64);
float PomFixedPointRelaxation @Default(0.2) @Clamp(0.1, 1.0);
// PomFixedPointThreshold controls the angle between view vector and surface at which fixed point resolver is switched into linear search
// For smooth height maps and moderate angles fixed point is much more stable than linear search, but it may not converge for large angles
// Thus when viewDirTS.z < PomFixedPointThreshold it is switched to linear search. This parameter takes effect only for POM Hybrid Mode
// For value 0.0 the result almost coincides with pure fixed point mode, except a very extreme angles where the result is averaged with linear search
// For value 0.9 the result almost coincides with pure linear search mode, except a very small angles where the result is averaged with fixed point iterations
float PomFixedPointThreshold @Default(0.1) @Clamp(0.0, 0.9);

[MATERIALCONFIG]

#include <Shaders/Materials/MaterialConfig.h>

[RENDERSTATE]

#include <Shaders/Materials/MaterialState.h>

[MATERIALCONSTANTS]

COLOR4F(BaseColor);
COLOR4F(EmissiveColor);
FLOAT1(MetallicValue);
FLOAT1(RoughnessValue);
FLOAT1(MaskThreshold);
BOOL1(UseBaseTexture);
BOOL1(UseNormalTexture);
BOOL1(UseRoughnessTexture);
BOOL1(UseMetallicTexture);
BOOL1(UseEmissiveTexture);
BOOL1(UseOcclusionTexture);
BOOL1(UseOrmTexture);
BOOL1(UseHeightTexture);
BOOL1(PomWriteDepth);
FLOAT1(HeightScale);
INT1(PomMaxSteps);
FLOAT1(PomFixedPointRelaxation);
FLOAT1(PomFixedPointThreshold);

[SHADER]

#define USE_NORMAL
#define USE_TANGENT
#define USE_TEXCOORD0
#define USE_TWO_SIDED_LIGHTING

#if RENDER_PASS == RENDER_PASS_EDITOR
  #define USE_DEBUG_INTERPOLATOR
#endif

[VERTEXSHADER]

#if VERTEX_SKINNING
  #define USE_SKINNING
#endif

#include <Shaders/Materials/MaterialVertexShader.h>

VS_OUT main(VS_IN Input)
{
  return FillVertexData(Input);
}

[PIXELSHADER]

#define USE_SIMPLE_MATERIAL_MODEL
#define USE_MATERIAL_EMISSIVE
#define USE_MATERIAL_OCCLUSION
#define USE_DECALS
#define USE_FOG
#define USE_CUSTOM_DITHER_NOISE

#if SHADER_WRITE_DEPTH
  #define USE_SHADER_WRITE_DEPTH
#endif

#define CUSTOM_GLOBALS float2 ParallaxTexCoord;

#include <Shaders/Materials/MaterialPixelShader.h>

Texture2D BaseTexture BIND_GROUP(BG_MATERIAL);
SamplerState BaseTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2D NormalTexture BIND_GROUP(BG_MATERIAL);
SamplerState NormalTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2D MetallicTexture BIND_GROUP(BG_MATERIAL);
SamplerState MetallicTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2D RoughnessTexture BIND_GROUP(BG_MATERIAL);
SamplerState RoughnessTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2D EmissiveTexture BIND_GROUP(BG_MATERIAL);
SamplerState EmissiveTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2D OcclusionTexture BIND_GROUP(BG_MATERIAL);
SamplerState OcclusionTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2D OrmTexture BIND_GROUP(BG_MATERIAL);
SamplerState OrmTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2D DitherNoiseTexture BIND_GROUP(BG_MATERIAL);

Texture2D HeightTexture BIND_GROUP(BG_MATERIAL);
SamplerState HeightTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

#include <Shaders/Common/ParallaxMapping.h>

void FillCustomGlobals()
{
  G.ParallaxTexCoord = G.Input.TexCoord0.xy;

  [branch]
  if (GetMaterialData(UseHeightTexture))
  {
    float3 viewDirWS = normalize(GetCameraPosition() - G.Input.WorldPosition);
    float3 viewDirTS = WorldToTangentSpace(viewDirWS);

    float2 uvInput = G.Input.TexCoord0.xy;
    float depth = 0.0;
#if POM_MODE == POM_MODE_HYBRID
    G.ParallaxTexCoord = ParallaxOcclusionMappingHybrid(
      HeightTexture, HeightTexture_AutoSampler,
      uvInput, viewDirTS,
      GetMaterialData(HeightScale), GetMaterialData(PomMaxSteps),
      GetMaterialData(PomFixedPointRelaxation), GetMaterialData(PomFixedPointThreshold),
      depth);
#elif POM_MODE == POM_MODE_FIXED_POINT
    G.ParallaxTexCoord = ParallaxOcclusionMappingFixedPoint(
      HeightTexture, HeightTexture_AutoSampler,
      uvInput, viewDirTS,
      GetMaterialData(HeightScale),
      GetMaterialData(PomFixedPointRelaxation),
      depth);
#elif POM_MODE == POM_MODE_LINEAR_SEARCH
    G.ParallaxTexCoord = ParallaxOcclusionMappingLinearSearch(
      HeightTexture, HeightTexture_AutoSampler,
      uvInput, viewDirTS,
      GetMaterialData(HeightScale), GetMaterialData(PomMaxSteps),
      depth);
#endif

#if SHADER_WRITE_DEPTH
    [branch]
    if (GetMaterialData(PomWriteDepth))
    {
      float2 uvDx = ddx(uvInput);
      float2 uvDy = ddy(uvInput);
      float3 pDx = ddx(G.Input.WorldPosition);
      float3 pDy = ddy(G.Input.WorldPosition);

      // world units per UV unit
      float uvToWorld = (length(pDx) + length(pDy)) / max(length(uvDx) + length(uvDy), 1e-6);

      // Offset only goes into the surface: the highest point of the relief stays on the polygon
      // It allows to keep early depth test exit 
      float heightScale = GetMaterialData(HeightScale);
      float d = heightScale >= 0.0 ? depth : 1.0 - depth;
      float s = d * abs(heightScale) * uvToWorld / max(viewDirTS.z, 0.001);

      G.Input.WorldPosition -= viewDirWS * s;
    }
#endif
  }
}

float3 GetNormal()
{
  [branch]
  if (GetMaterialData(UseNormalTexture))
  {
    float3 normalTS = DecodeNormalTexture(NormalTexture.Sample(NormalTexture_AutoSampler, G.ParallaxTexCoord));
    return TangentToWorldSpace(normalTS);
  }
  else
  {
    return G.Input.Normal;
  }
}

float3 GetBaseColor()
{
  float3 baseColor = GetMaterialData(BaseColor).rgb * GetInstanceData().Color.rgb;

  // note that the default material actually doesn't support per-vertex colors
#if defined(USE_COLOR0)
  baseColor *= G.Input.Color0;
#endif

  [branch]
  if (GetMaterialData(UseBaseTexture))
  {
    baseColor *= BaseTexture.Sample(BaseTexture_AutoSampler, G.ParallaxTexCoord).rgb;
  }
  
  return baseColor;
}

float GetMetallic()
{
  [branch]
  if (GetMaterialData(UseOrmTexture))
  {
    return OrmTexture.Sample(OrmTexture_AutoSampler, G.ParallaxTexCoord).b;
  }
  else if (GetMaterialData(UseMetallicTexture))
  {
    return MetallicTexture.Sample(MetallicTexture_AutoSampler, G.ParallaxTexCoord).r;
  }
  else
  {
    return GetMaterialData(MetallicValue);
  }
}

float GetReflectance()
{
  return 0.5f;
}

float GetRoughness()
{
  [branch]
  if (GetMaterialData(UseOrmTexture))
  {
    return GetMaterialData(RoughnessValue) * OrmTexture.Sample(OrmTexture_AutoSampler, G.ParallaxTexCoord).g;
  }
  else if (GetMaterialData(UseRoughnessTexture))
  {
    return GetMaterialData(RoughnessValue) * RoughnessTexture.Sample(RoughnessTexture_AutoSampler, G.ParallaxTexCoord).r;
  }
  else
  {
    return GetMaterialData(RoughnessValue);
  }
}

float GetOpacity()
{
  float opacity = GetMaterialData(BaseColor).a * GetInstanceData().Color.a;

  [branch]
  if (GetMaterialData(UseBaseTexture))
  {
    opacity *= BaseTexture.Sample(BaseTexture_AutoSampler, G.ParallaxTexCoord).a;
  }

  #if BLEND_MODE == BLEND_MODE_MASKED
    return opacity - GetMaterialData(MaskThreshold);
  #else
    return opacity;
  #endif
}

float3 GetEmissiveColor()
{
  [branch]
  if (GetMaterialData(UseEmissiveTexture))
  {
    return EmissiveTexture.Sample(EmissiveTexture_AutoSampler, G.ParallaxTexCoord).rgb * GetMaterialData(EmissiveColor).rgb;
  }
  else
  {
    return GetMaterialData(EmissiveColor).rgb;
  }
}

float GetOcclusion()
{
  [branch]
  if (GetMaterialData(UseOrmTexture))
  {
    return OrmTexture.Sample(OrmTexture_AutoSampler, G.ParallaxTexCoord).r;
  }
  else if (GetMaterialData(UseOcclusionTexture))
  {
    return OcclusionTexture.Sample(OcclusionTexture_AutoSampler, G.ParallaxTexCoord).r;
  }
  else
  {
    return 1.0f;
  }
}

float4 GetDitherNoise(float2 pixelCoord)
{
  uint2 noiseTextureSize;
  DitherNoiseTexture.GetDimensions(noiseTextureSize.x, noiseTextureSize.y);

  return DitherNoiseTexture.SampleLevel(PointSampler, pixelCoord / noiseTextureSize, 0);
}
