[PLATFORMS]
ALL

[PERMUTATIONS]

CAMERA_MODE
LUT_MODE

[RENDERSTATE]

DepthTest = false
DepthWrite = false
CullMode = CullMode_None

[VERTEXSHADER]

#include <Shaders/Pipeline/FullscreenTriangleVertexShader.h>

[PIXELSHADER]

#include <Shaders/Pipeline/FullscreenTriangleInterpolator.h>
#include <Shaders/Common/Common.h>
#include <Shaders/Common/GlobalConstants.h>
#include "TonemapConstants.h"

float3 TonemapReinhard(float3 color)
{
	float whiteSqr = WhitePoint * WhitePoint;

    // Could be set to greater than 1.0 for HDR output
    float OutputMaxValue = 1.0;
	return color * (1.0f + color / whiteSqr) / (1.0f + color / OutputMaxValue);
}

// From http://filmicgames.com/archives/75
float3 HableFunction(float3 x)
{
  float A = FilmicShoulder;
  float B = FilmicLinearStrength;
  float C = FilmicLinearAngle;
  float D = FilmicToe;
  float E = 0.02;
  float F = 0.30;

  return ((x*(A*x+ C*B)+ D*E) / (x*(A*x + B) + D*F)) - E/F;
}

float3 TonemapFilmic(float3 color)
{
  float3 numerator = HableFunction(color);
  float3 denominator = HableFunction(WhitePoint);

  return numerator / denominator;
}

float3 AdjustContrast(float3 x)
{
  float3 x2 = x*x;
  float3 x3 = x2*x;

  float a = ContrastParams.x;
  float b = ContrastParams.y;
  float c = ContrastParams.z;

  return a*x3 + b*x2 + c*x;
}

Texture2D VignettingTexture;
Texture2D NoiseTexture;

Texture2DArray SceneColorTexture;
Texture2DArray BloomTexture;

#if LUT_MODE == LUT_MODE_ONE
  Texture3D Lut1Texture;
#elif LUT_MODE == LUT_MODE_TWO
  Texture3D Lut1Texture;
  Texture3D Lut2Texture;
#endif

float3 ScreenSpaceDither( float2 texCoords )
{
  float t = frac( GlobalTime );
  texCoords = (texCoords + t) * (ViewportSize.xy / 256.0);

  // map to -0.5..1.5 bit range for an 8bit output target
  return NoiseTexture.SampleLevel(PointSampler, texCoords, 0.0).rgb * (2.0 / 255.0) - (0.5 / 255.0);
}

float PlotTonemapCurve(int mode, float2 uv)
{
  float lineWidth = 0.002;
  float offset = 0.001;

  float2 p0 = float2(uv.x, 0);
  float2 p1 = float2(uv.x + offset, 0);

  float x0 = p0.x * p0.x * WhitePoint;
  float x1 = p1.x * p1.x * WhitePoint;

  if (mode == TONEMAPMODE_LINEAR)
  {
    p0.y = x0 / WhitePoint;
    p1.y = x1 / WhitePoint;
  }
  else if (mode == TONEMAPMODE_REINHARD)
  {
    p0.y = TonemapReinhard(x0).r;
    p1.y = TonemapReinhard(x1).r;
  }
  else if (mode == TONEMAPMODE_FILMIC)
  {
    p0.y = TonemapFilmic(x0).r;
    p1.y = TonemapFilmic(x1).r;
  }

  float2 delta = (p1 - p0) * ViewportSize.xy;
  float cosPhi = delta.x / length(delta);
  float height = lineWidth / 2.0 / cosPhi;
  float d = abs(1 - uv.y - p0.y) - height;
  float l = smoothstep(0.005, 0.0, d);

  return l;
}

float4 main(PS_IN Input) : SV_Target
{
#if CAMERA_MODE == CAMERA_MODE_STEREO
  s_ActiveCameraEyeIndex = Input.RenderTargetArrayIndex;
#endif

  float3 sceneColor = SceneColorTexture.Load(int4(Input.Position.xy, s_ActiveCameraEyeIndex, 0)).rgb;
  sceneColor *= Exposure;

  float3 bloom = BloomTexture.SampleLevel(LinearClampSampler, float3(Input.TexCoord0.xy, s_ActiveCameraEyeIndex), 0.0).rgb;
  sceneColor += bloom;

  // Vignetting
  float3 vignetting = VignettingTexture.SampleLevel(LinearClampSampler, Input.TexCoord0.xy, 0.0).rgb;
  sceneColor *= vignetting;

  // Ensure all values passed to tonemapping are non-negative
  sceneColor = max(sceneColor, 0.0);

  // Tonemapping
  float3 tonemappedColor = 0;
  if (TonemapMode == TONEMAPMODE_LINEAR)
  {
    tonemappedColor = sceneColor / WhitePoint;
  }
  else if (TonemapMode == TONEMAPMODE_REINHARD)
  {
    tonemappedColor = TonemapReinhard(sceneColor);
  }
  else if (TonemapMode == TONEMAPMODE_FILMIC)
  {
    tonemappedColor = TonemapFilmic(sceneColor);
  }
  else if (TonemapMode == TONEMAPMODE_ACES)
  {
    
  }
  else if (TonemapMode == TONEMAPMODE_AGX)
  {
    
  }

  float3 color = saturate(tonemappedColor);
  
  // Color grading with LUTs if enabled
  #if LUT_MODE != LUT_MODE_NONE

    color = lerp(color, Lut1Texture.Sample(LinearClampSampler, color), Lut1Strength);

    #if LUT_MODE == LUT_MODE_TWO

      color = lerp(color, Lut2Texture.Sample(LinearClampSampler, color), Lut2Strength);

    #endif

  #endif

  // Color correction
  float luminance = GetLuminance(color);

  float3 moodColor = lerp(0.0, MoodColor.rgb, saturate(luminance * 2.0));
  moodColor = lerp(moodColor, 1.0, saturate(luminance - 0.5) * 2.0);
  color = lerp(color, moodColor, saturate( luminance * MoodStrength ));

  color = saturate(lerp(luminance.xxx, color, Saturation));
  color = AdjustContrast(color);

  // Cheap approx convert to sRGB before dither
  color = sqrt(color);

  // Dither
  color += ScreenSpaceDither(Input.TexCoord0.xy);

  // Convert back to linear
  color *= color;

  if (VisualizeCurve)
  {
    float2 uv = (Input.TexCoord0.xy - 0.03) / 0.37;
    if (all(saturate(uv) == uv))
    {
      // background
      color = lerp(color, 0, 0.9);

      if (CompareCurve != TONEMAPMODE_NONE)
      {
        float curve1 = PlotTonemapCurve(CompareCurve, uv);
        color = lerp(color, float3(0, 1, 0), curve1);
      }

      float curve0 = PlotTonemapCurve(TonemapMode, uv);
      color = lerp(color, float3(1, 0, 0), curve0);      
    }
  }

  return float4(color, 1);
}
