[PLATFORMS]
ALL

[PERMUTATIONS]

CAMERA_MODE

[RENDERSTATE]

DepthTest = false
DepthWrite = false
CullMode = CullMode_None

[VERTEXSHADER]

#include <Shaders/Pipeline/FullscreenTriangleVertexShader.h>

[PIXELSHADER]

#include <Shaders/Pipeline/FullscreenTriangleInterpolator.h>
#include <Shaders/Common/Common.h>
#include <Shaders/Common/GlobalConstants.h>
#include "TonemapConstants.h"

float3 TonemapReinhard(float3 color)
{
    return ReinhardFunction(color, TonemapNormalization);
}

float3 TonemapFilmic(float3 color)
{
  float3 color_tonemapped = HableFunction(color, FilmicToe, FilmicLinearStrength, FilmicLinearAngle, FilmicShoulder);

  return color_tonemapped * TonemapNormalization;
}

float3 TonemapACES(float3 color)
{
  const float3x3 ACESInputMat =
  {
    {0.59719, 0.35458, 0.04823},
    {0.07600, 0.90834, 0.01566},
    {0.02840, 0.13383, 0.83777}
  };
  
  const float3x3 ACESOutputMat =
  {
    { 1.60475, -0.53108, -0.07367},
    {-0.10208,  1.10813, -0.00605},
    {-0.00327, -0.07276,  1.07602}
  };

  color = mul(ACESInputMat, color);
  float3 color_tonemapped = ACESFunction(color, AcesToe, AcesSlope, AcesShoulder);
  color_tonemapped = mul(ACESOutputMat, color_tonemapped);

  return color_tonemapped * TonemapNormalization;
}

// This is an approximation and simplification of EaryChow's AgX implementation that is used by Blender.
// This code is based off of the script that generates the AgX_Base_sRGB.cube LUT that Blender uses.
// Source: https://github.com/EaryChow/AgX_LUT_Gen/blob/main/AgXBasesRGB.py
// Colorspace transformation source: https://www.colour-science.org:8010/apps/rgb_colourspace_transformation_matrix
float3 TonemapAgX(float3 color)
{
  // Combined Rec. 709 to Rec. 2020 and Blender AgX inset matrices:
  const float3x3 rec709_to_rec2020_agx_inset_matrix =
  {
    {0.544814746488245, 0.373787398372697, 0.0813978551390581},
    {0.140416948464053, 0.754137554567394, 0.105445496968552},
    {0.0888104196149096, 0.178871756420858, 0.732317823964232}
  };

  // Combined inverse AgX outset matrix and Rec. 2020 to Rec. 709 matrices.
  const float3x3 agx_outset_rec2020_to_rec709_matrix =
  {
    { 1.96488741169489, -0.855988495690215, -0.108898916004672},
    {-0.299313364904742,  1.32639796461980, -0.0270845997150571},
    {-0.164352742528393, -0.238183969428088,  1.40253671195648}
  };

  const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0

  // Apply inset matrix.
  color = mul(rec709_to_rec2020_agx_inset_matrix, color);

  // Use the allenwp tonemapping curve to match the Blender AgX curve while
  // providing stability across all variable dyanimc range (SDR, HDR, EDR).
  color = AllenwpCurve(color, AwpContrast, AwpToeA, AwpSlope, AwpW);

  // Clipping to output_max_value is required to address a cyan colour that occurs
  // with very bright inputs.
  color = min(output_max_value, color);

  // Apply outset to make the result more chroma-laden and then go back to Rec. 709.
  color = mul(agx_outset_rec2020_to_rec709_matrix, color);

  // Blender's lusRGB.compensate_low_side is too complex for this shader, so
  // simply return the color, even if it has negative components. These negative
  // components may be useful for subsequent color adjustments.
  return color;
}

float3 AdjustContrast(float3 x)
{
  float3 x2 = x*x;
  float3 x3 = x2*x;

  float a = ContrastParams.x;
  float b = ContrastParams.y;
  float c = ContrastParams.z;

  return a*x3 + b*x2 + c*x;
}

Texture2D VignettingTexture;
Texture2D NoiseTexture;

Texture2DArray SceneColorTexture;
Texture2DArray BloomTexture;

Texture3D Lut1Texture;
Texture3D Lut2Texture;

float3 ScreenSpaceDither( float2 texCoords )
{
  float t = frac( GlobalTime );
  texCoords = (texCoords + t) * (ViewportSize.xy / 256.0);

  // map to -0.5..1.5 bit range for an 8bit output target
  return NoiseTexture.SampleLevel(PointSampler, texCoords, 0.0).rgb * (2.0 / 255.0) - (0.5 / 255.0);
}

float4 main(PS_IN Input) : SV_Target
{
#if CAMERA_MODE == CAMERA_MODE_STEREO
  s_ActiveCameraEyeIndex = Input.RenderTargetArrayIndex;
#endif

  float3 sceneColor = SceneColorTexture.Load(int4(Input.Position.xy, s_ActiveCameraEyeIndex, 0)).rgb;
  sceneColor *= Exposure;

  float3 bloom = BloomTexture.SampleLevel(LinearClampSampler, float3(Input.TexCoord0.xy, s_ActiveCameraEyeIndex), 0.0).rgb;
  sceneColor += bloom;

  // Ensure all values passed to tonemapping are non-negative
  sceneColor = max(sceneColor, 0.0);

  // Tonemapping
  float3 tonemappedColor = 0;
  if (TonemapMode == TONEMAPMODE_LINEAR)
  {
    tonemappedColor = sceneColor * TonemapNormalization;
  }
  else if (TonemapMode == TONEMAPMODE_REINHARD)
  {
    tonemappedColor = TonemapReinhard(sceneColor);
  }
  else if (TonemapMode == TONEMAPMODE_FILMIC)
  {
    tonemappedColor = TonemapFilmic(sceneColor);
  }
  else if (TonemapMode == TONEMAPMODE_ACES)
  {
    tonemappedColor = TonemapACES(sceneColor);
  }
  else if (TonemapMode == TONEMAPMODE_AGX)
  {
    tonemappedColor = TonemapAgX(sceneColor);
  }

  float3 color = saturate(tonemappedColor);
  
  // Color grading with LUTs if enabled
  if (NumLUTs > 0)
  {
    color = lerp(color, Lut1Texture.Sample(LinearClampSampler, color), Lut1Strength);

    if (NumLUTs > 1)
    {
      color = lerp(color, Lut2Texture.Sample(LinearClampSampler, color), Lut2Strength);
    }
  }

  // Color correction
  float luminance = GetLuminance(color);

  float3 moodColor = lerp(0.0, MoodColor.rgb, saturate(luminance * 2.0));
  moodColor = lerp(moodColor, 1.0, saturate(luminance - 0.5) * 2.0);
  color = lerp(color, moodColor, saturate( luminance * MoodStrength ));

  color = saturate(lerp(luminance.xxx, color, Saturation));
  color = AdjustContrast(color);

  // Vignetting
  float3 vignetting = VignettingTexture.SampleLevel(LinearClampSampler, Input.TexCoord0.xy, 0.0).rgb;
  color *= vignetting;

  // Cheap approx convert to sRGB before dither
  color = sqrt(color);

  // Dither
  color += ScreenSpaceDither(Input.TexCoord0.xy);

  // Convert back to linear
  color *= color;

  return float4(color, 1);
}
