string %Shader { "Shaders/Editor/Texture3DPreviewRaymarch.ezShader" }

Permutation
{
  string %Variable { "TWO_SIDED" }
  string %Value { "TRUE" }
}

Permutation
{
  string %Variable { "SHADING_MODE" }
  string %Value { "SHADING_MODE_FULLBRIGHT" }
}

Permutation
{
  string %Variable { "BLEND_MODE" }
  string %Value { "BLEND_MODE_OPAQUE" }
}

Constant
{
  string %Variable { "OpacityMultiplier" }
  float %Value { 1.0 }
}
