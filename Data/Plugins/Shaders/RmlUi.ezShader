[PLATFORMS]
ALL

[PERMUTATIONS]

RMLUI_MODE
RMLUI_GRADIENT

[RENDERSTATE]

BlendingEnabled0 = true
DestBlend0 = Blend_InvSrcAlpha
SourceBlend0 = Blend_One
DestBlendAlpha0 = Blend_InvSrcAlpha
SourceBlendAlpha0 = Blend_One
ScissorTest = true
DepthEnable = false
DepthWrite = false
CullMode = CullMode_None
StencilReadMask = 1
StencilWriteMask = 1
StencilRef = 1

#if RMLUI_MODE == RMLUI_MODE_STENCIL_TEST

StencilEnable = true
StencilCompareFunc = CompareFunc_Equal

#elif RMLUI_MODE == RMLUI_MODE_STENCIL_SET

StencilEnable = true
StencilCompareFunc = CompareFunc_Always
StencilPassOp = StencilOp_Replace
ColorWriteMask = 0

#endif

[SHADER]

struct PS_IN
{
  float4 Position : SV_Position;
  float2 TexCoord0 : TEXCOORD0;
  float4 Color0 : COLOR0;
};

[VERTEXSHADER]

#include "RmlUiConstants.h"

struct VS_IN
{
  float2 Position : POSITION;
  float2 TexCoord0 : TEXCOORD0;
  float4 Color0 : COLOR0;
};

typedef PS_IN VS_OUT;

VS_OUT main(VS_IN Input)
{
  VS_OUT RetVal;

  float2 translatedPos = Input.Position + UiTranslation;
  RetVal.Position = mul(UiTransform, float4(translatedPos, 0, 1));

  RetVal.TexCoord0 = Input.TexCoord0;
  RetVal.Color0 = Input.Color0;

  return RetVal;
}

[PIXELSHADER]

#include <Shaders/Common/Common.h>
#include "RmlUiConstants.h"

float4 lerp_stop_colors(float t)
{
    float4 color = GradientStopColors[0];

    for (uint i = 1; i < GradientNumStops; i++)
    {
        color = lerp(color, GradientStopColors[i], smoothstep(GRADIENT_GET_STOP_POS(i-1), GRADIENT_GET_STOP_POS(i), t));
    }

    return color;
};

float glsl_mod(float x, float y)
{
    return x - y * floor(x / y);
}

#if RMLUI_MODE == RMLUI_MODE_STENCIL_SET
  void main()
  {
  }
#else
  Texture2D BaseTexture;
  SamplerState BaseTexture_AutoSampler;

  float4 main(PS_IN Input) : SV_Target
  {
  #if RMLUI_GRADIENT

    float2 m_p = GradientParams0;
    float2 m_v = GradientParams1;
    float t = 0.0;

    if (GradientFunc == GRADIENT_LINEAR || GradientFunc == GRADIENT_REPEATING_LINEAR)
    {
        float dist_square = dot(m_v, m_v);
        float2 V = Input.TexCoord0.xy - m_p;
        t = dot(m_v, V) / dist_square;
    }
    else if (GradientFunc == GRADIENT_RADIAL || GradientFunc == GRADIENT_REPEATING_RADIAL)
    {
        float2 V = Input.TexCoord0.xy - m_p;
        t = length(m_v * V);
    }
    else if (GradientFunc == GRADIENT_CONIC || GradientFunc == GRADIENT_REPEATING_CONIC)
    {
        float2x2 R = float2x2(m_v.x, -m_v.y, m_v.y, m_v.x);
        float2 V = mul((Input.TexCoord0.xy - m_p), R);
        t = 0.5 + atan2(-V.x, V.y) / (2.0 * PI);
    }

    if (GradientFunc >= GRADIENT_REPEATING_LINEAR && GradientFunc <= GRADIENT_REPEATING_CONIC)
    {
        float t0 = GRADIENT_GET_STOP_POS(0);
        float t1 = GRADIENT_GET_STOP_POS(GradientNumStops - 1);
        t = t0 + glsl_mod(t - t0, t1 - t0);
    }

    return Input.Color0 * lerp_stop_colors(t);

  #else

    float4 textureColor = BaseTexture.Sample(BaseTexture_AutoSampler, Input.TexCoord0.xy);
    if (TextureNeedsAlphaMultiplication)
    {
      textureColor.rgb *= textureColor.a;
    }

    return textureColor * Input.Color0;

  #endif
  }
#endif