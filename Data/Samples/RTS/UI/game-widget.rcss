.game-widget {
  font-size: 14dp;
  color: white;
  position: absolute;
  width: 200dp;
  border: 1dp rgba(100, 100, 120, 200);
  border-radius: 4dp;
  background-color: rgba(100, 100, 120, 160);
}

.game-widget .title {
  padding: 5dp;
  border-radius: 3dp 3dp 0 0;
  decorator: linear-gradient(180deg, rgb(219, 108, 109) 38%, rgb(185, 26, 27) 45%, rgb(183, 22, 23)); 
}

.game-widget .content {
  padding: 5dp;
  margin-left: 5dp;
}

.game-widget .property {
  display: flex;

  /* Vertically center label and input*/
  align-items: center;

  /* Align to left */
  justify-content: flex-start;
}

.right-aligned {
  margin-left: auto;
}

.right-aligned select {
  margin-left: auto;
}